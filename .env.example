# WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_API_VERSION=v21.0
CLIENT_WHATSAPP_NUMBER=919876543210

# WhatsApp Template Names (must be approved in Meta Business Manager)
CUSTOMER_TEMPLATE_NAME=license_expiry_reminder
CLIENT_TEMPLATE_NAME=license_expiry_client_notification
TEMPLATE_LANGUAGE_CODE=hi

# Application Settings
APP_SECRET_KEY=change-this-to-a-secure-random-string-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TIMEZONE=Asia/Kolkata

# Demo Mode (set to true if WhatsApp credentials are not configured)
DEMO_MODE=true
